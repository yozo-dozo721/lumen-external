						for (auto& pt : sp)
							poly.push_back(ImVec2(pt.x / 1000.0f, pt.y / 1000.0f));

						cham_draw->AddConcavePolyFilled(poly.data(), static_cast<int>(poly.size()), cham_fill_col);
						cham_draw->AddPolyline(poly.data(), static_cast<int>(poly.size()), cham_outline_col, ImDrawFlags_Closed, 1.0f);
					}
				}

				ImFont* font = ImGui::GetFont();
				float font_size = ImGui::GetFontSize();
				const char* text = "Replicated Position";
				float text_width = font->CalcTextSizeA(font_size, FLT_MAX, 0.f, text).x;

				ImU32 text_col = IM_COL32(
					static_cast<int>(settings::movement::desync::text_colour[0] * 255.f),
					static_cast<int>(settings::movement::desync::text_colour[1] * 255.f),
					static_cast<int>(settings::movement::desync::text_colour[2] * 255.f),
					static_cast<int>(settings::movement::desync::text_colour[3] * alpha_mult * 255.f)
				);

				esp::draw_text_outlined(cham_draw, font, font_size,
					ImVec2(std::round(left + (right - left) * 0.5f - text_width * 0.5f), std::round(top) - font_size - 2.f),
					text_col, text);
			}
		}
