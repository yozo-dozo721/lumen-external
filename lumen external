							.name = child_name,
							.display_name = child_name,
							.health = has_humanoid ? humanoid.get_health() : 0.0f,
							.max_health = has_humanoid ? humanoid.get_max_health() : 0.0f,
							.knocked = knocked,
							.is_custom = true,
							.custom_path = npc_path_str,
							.priority = player_priority::neutral
						};

						if (has_humanoid)
						{
							entity.humanoid = humanoid;
						}

						for (rbx::c_part& part : parts_to_cache)
						{
							if (!part.address)
							{
								continue;
							}

							std::string part_name = part.get_name();
							std::string part_class_name = part.get_class_name();

							if (part_name == "Humanoid" && has_humanoid)
							{
								entity.humanoid = rbx::c_humanoid(part.address);
							}

							if (part_name == "HumanoidRootPart")
							{
								entity.humanoid_root_part = rbx::c_part(part.address);
							}

							if (is_part_class(part_class_name))
							{
								if (part_name.empty())
								{
									part_name = "Part";
								}
								entity.parts[part_name] = part;
							}
						}

						if (!entity.parts.empty())
						{
							temp_cache.push_back(entity);
						}
					}
				}
			}
		}

		{
			std::lock_guard<std::mutex> lock(cache::mtx);
			cache::players = std::move(temp_cache);
		}

		std::this_thread::sleep_for(0.1s);
	}
}

