			mesh.faces.resize(mesh.lods[1]);
		}
		
		mesh.num_vertices = num_vertices;
		mesh.num_faces = static_cast<uint32_t>(mesh.faces.size());
		return true;
	}

	static bool parse_mesh_v4(const std::vector<uint8_t>& data, size_t offset, parsed_mesh& mesh)
	{
		size_t pos = offset;
		
		if (pos + 24 > data.size())
