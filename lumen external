-- ---- Combo (custom look) -------------------------------------------------
function ImAdd.Combo(label, current, items)
    local preview = items[current + 1] or "<none>"
    local tw, th = I.CalcTextSize(preview)
    local w = 220
    local h = th + 10
    local pos_x, pos_y = I.GetCursorScreenPos()

    I.TextUnformatted(label)
    I.SetCursorScreenPos(pos_x, pos_y + th + 4)

    local p = I.InvisibleButton(label .. "##combo", w, h)
    local hovered = I.IsItemHovered()
    local dl = I.GetWindowDrawList()
    local bg = hovered and { 0.26,0.30,0.38,1 } or { 0.20,0.23,0.29,1 }
    dl:AddRectFilled(pos_x, pos_y + th + 4, pos_x + w, pos_y + th + 4 + h,
                     ColorU32(RGB(bg[1],bg[2],bg[3],bg[4])), 6)
    dl:AddRect(pos_x, pos_y + th + 4, pos_x + w, pos_y + th + 4 + h,
               ColorU32(RGB(0.20,0.22,0.26,1)), 6, 0, 1)
    dl:AddText(pos_x + 10, pos_y + th + 4 + (h - th) * 0.5,
               ColorU32(RGB(0.92,0.93,0.95,1)), preview)
    dl:AddText(pos_x + w - 20, pos_y + th + 4 + (h - th) * 0.5 - 3,
               ColorU32(RGB(0.45,0.47,0.52,1)), "v")

    if p then I.OpenPopup("##combo_pop_" .. label) end

    local changed = false
    if I.BeginPopup and I.BeginPopup("##combo_pop_" .. label) then
        for i, name in ipairs(items) do
            if I.Selectable(name, (i - 1) == current) then
                current = i - 1
                changed = true
                I.CloseCurrentPopup()
            end
        end
        I.EndPopup()
    end
    return changed, current
end

-- ---- MultiCombo ----------------------------------------------------------
function ImAdd.MultiCombo(label, mask, items)
    local preview = "None"
    local count = 0
    for i = 1, #items do if (mask >> (i - 1)) & 1 == 1 then count = count + 1 end end
    if count == 1 then
        for i = 1, #items do
            if (mask >> (i - 1)) & 1 == 1 then preview = items[i] end
        end
    elseif count > 1 then
        preview = tostring(count) .. " selected"
    end

    local tw, th = I.CalcTextSize(preview)
    local w, h = 220, th + 10
    local pos_x, pos_y = I.GetCursorScreenPos()
    I.TextUnformatted(label)
    I.SetCursorScreenPos(pos_x, pos_y + th + 4)

    local p = I.InvisibleButton(label .. "##mc", w, h)
    local hovered = I.IsItemHovered()
    local dl = I.GetWindowDrawList()
    local bg = hovered and { 0.26,0.30,0.38,1 } or { 0.20,0.23,0.29,1 }
    dl:AddRectFilled(pos_x, pos_y + th + 4, pos_x + w, pos_y + th + 4 + h,
                     ColorU32(RGB(bg[1],bg[2],bg[3],bg[4])), 6)
    dl:AddRect(pos_x, pos_y + th + 4, pos_x + w, pos_y + th + 4 + h,
               ColorU32(RGB(0.20,0.22,0.26,1)), 6, 0, 1)
    dl:AddText(pos_x + 10, pos_y + th + 4 + (h - th) * 0.5,
               ColorU32(RGB(0.92,0.93,0.95,1)), preview)

    if p then I.OpenPopup("##mc_pop_" .. label) end

    local changed = false
    if I.BeginPopup and I.BeginPopup("##mc_pop_" .. label) then
        for i, name in ipairs(items) do
            local sel = (mask >> (i - 1)) & 1 == 1
            if I.Selectable(name, sel) then
                mask = mask ~ (1 << (i - 1))
                changed = true
            end
        end
        I.EndPopup()
    end
    return changed, mask
end

