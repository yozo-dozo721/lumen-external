						rbx::c_model_instance local_character = local_snapshot.instance.address != 0 ? 
							rbx::c_player(local_snapshot.instance.address).get_model_instance() : rbx::c_model_instance(0);

						if (local_character.address != 0)
						{
							std::uint64_t hrp_addr = local_character.find_first_child("HumanoidRootPart");
							if (hrp_addr != 0)
							{
								rbx::c_part hrp(hrp_addr);
								rbx::c_primitive hrp_prim = hrp.get_primitive();
								if (hrp_prim.address != 0)
								{
									frozen_hrp_position = hrp_prim.get_position();
									frozen_hrp_rotation = hrp_prim.get_rotation();

									std::uint64_t humanoid_addr = local_character.find_first_child("Humanoid");
									if (humanoid_addr != 0)
									{
										rbx::c_humanoid humanoid(humanoid_addr);
										std::uint8_t rig_type = humanoid.get_rig_type();
										bool is_r15 = (rig_type == 1);

										if (is_r15)
										{
											std::vector<std::string> part_names = {
												"Head", "UpperTorso", "LowerTorso",
												"LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
												"RightUpperLeg", "RightLowerLeg", "RightFoot",
												"LeftUpperArm", "LeftLowerArm", "LeftHand",
												"RightUpperArm", "RightLowerArm", "RightHand"
											};

											for (const auto& name : part_names)
											{
												std::uint64_t part_addr = local_character.find_first_child(name);
												if (part_addr != 0)
												{
													desync_parts.push_back(rbx::c_part(part_addr));
												}
											}
										}
										else
										{
											std::vector<std::string> part_names = {
												"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"
											};

											for (const auto& name : part_names)
											{
												std::uint64_t part_addr = local_character.find_first_child(name);
												if (part_addr != 0)
												{
													desync_parts.push_back(rbx::c_part(part_addr));
												}
											}
										}
									}
								}
							}
						}
						
						is_desync_active = true;
					}
					else
					{
						memory->write<std::int32_t>(memory->m_base_address + Offsets::Desync::Pointer, 38760);
						
						std::lock_guard<std::mutex> lock(frozen_data_mtx);
						if (is_desync_active && !desync_parts.empty())
						{
							is_fading_out = true;
							fade_start_time = std::chrono::steady_clock::now();
							fade_start_hrp_position = frozen_hrp_position;
							fade_start_hrp_rotation = frozen_hrp_rotation;
							fade_parts = desync_parts;
						}
						desync_parts.clear();
						is_desync_active = false;
					}
				}
			}
		}

		bool is_active()
		{
			return is_desync_active;
		}

		void run()
		{
			std::thread(desync_thread).detach();
		}
	}

