local function ApplyStyle()
    local s = I.GetStyle()
    if not s then return end
    s.WindowRounding = 0
    s.ChildRounding  = 6
    s.FrameRounding  = 6
    s.GrabRounding   = 4
    s.PopupRounding  = 6
    s.ScrollbarRounding = 6
    s.TabRounding    = 6
    if I.GetIO and I.GetIO().IniFilename then
        I.GetIO().IniFilename = nil  -- don't pollute the folder
    end
end

