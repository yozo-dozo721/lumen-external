        window->DrawList->AddLine(pos + ImVec2(label_size.x + style.ItemInnerSpacing.x + thickness, size.y / 2), pos + ImVec2(size.x - thickness, size.y / 2), GetColorU32(ImGuiCol_Border), thickness);
