		__forceinline std::vector<ImVec2> generate_hull(const std::vector<ImVec2>& projected)
		{
			if (projected.size() < 3)
				return {};

			std::vector<ImVec2> sorted_projected = projected;
			std::sort(sorted_projected.begin(), sorted_projected.end(), [](const ImVec2& a, const ImVec2& b)
			{
				return a.x < b.x || (a.x == b.x && a.y < b.y);
			});

			std::vector<ImVec2> hull;
			auto cross = [](const ImVec2& O, const ImVec2& A, const ImVec2& B)
			{
				return (A.x - O.x) * (B.y - O.y) - (A.y - O.y) * (B.x - O.x);
			};

			for (auto& p : sorted_projected)
			{
				while (hull.size() >= 2 && cross(hull[hull.size() - 2], hull[hull.size() - 1], p) <= 0)
					hull.pop_back();
				hull.push_back(p);
			}

			size_t t = hull.size() + 1;
			for (int i = static_cast<int>(sorted_projected.size()) - 1; i >= 0; --i)
			{
				auto& p = sorted_projected[i];
				while (hull.size() >= t && cross(hull[hull.size() - 2], hull[hull.size() - 1], p) <= 0)
					hull.pop_back();
				hull.push_back(p);
			}

			if (!hull.empty())
				hull.pop_back();

			return hull;
		}

		__forceinline void draw_text_outlined(ImDrawList* draw, ImFont* font, float font_size, ImVec2 pos, ImU32 col, const char* text_begin, const char* text_end = nullptr)
		{
			pos.x = std::round(pos.x);
			pos.y = std::round(pos.y);

			ImU32 outline_alpha = (col >> 24) & 0xFF;
			ImU32 outline_col = IM_COL32(0, 0, 0, outline_alpha);

			for (int x = -1; x <= 1; x++)
			{
				for (int y = -1; y <= 1; y++)
				{
					if (x == 0 && y == 0)
					{
						continue;
					}
					draw->AddText(font, font_size, ImVec2(pos.x + x, pos.y + y), outline_col, text_begin, text_end);
				}
			}

			draw->AddText(font, font_size, pos, col, text_begin, text_end);
		}

		visualization_data_t get_visualization_data()
		{
			visualization_data_t data{};
			data.should_render = false;

			if (!settings::movement::desync::visualize || !game::visualengine)
			{
				return data;
			}

			if (!is_desync_active && !is_fading_out && !is_fading_in)
			{
				return data;
			}

			if (is_desync_active && !is_fading_in && desync_parts.empty())
			{
				return data;
			}

			if (is_fading_out && fade_parts.empty())
			{
				return data;
			}

			if (is_fading_in && desync_parts.empty())
			{
				return data;
			}

			cache::entity_t local_snapshot;
			{
				std::lock_guard<std::mutex> lock(cache::mtx);
				local_snapshot = cache::local_player;
			}

			if (local_snapshot.instance.address == 0)
			{
				return data;
			}

			rbx::c_part hrp = local_snapshot.humanoid_root_part.address ? local_snapshot.humanoid_root_part : rbx::c_part{};
			if (!hrp.address)
			{
				auto hrp_it = local_snapshot.parts.find("HumanoidRootPart");
				if (hrp_it != local_snapshot.parts.end())
				{
					hrp = hrp_it->second;
				}
			}

			if (!hrp.address)
			{
				return data;
			}

			rbx::c_primitive hrp_prim = hrp.get_primitive();
			if (!hrp_prim.address)
			{
				return data;
			}

			math::vector3 current_hrp_pos = hrp_prim.get_position();
			math::matrix3 current_hrp_rot = hrp_prim.get_rotation();

			std::lock_guard<std::mutex> lock(frozen_data_mtx);

			data.use_fade_out = is_fading_out;
			data.use_fade_in = is_fading_in;
			data.fade_progress = 0.0f;

			if (data.use_fade_out)
			{
				auto current_time = std::chrono::steady_clock::now();
				auto elapsed_ms = std::chrono::duration_cast<std::chrono::milliseconds>(current_time - fade_start_time).count();
				data.fade_progress = static_cast<float>(elapsed_ms) / 300.0f;

				if (data.fade_progress >= 1.0f)
				{
					is_fading_out = false;
					fade_parts.clear();
					return data;
				}

				float t = data.fade_progress;
				float ease_out = 1.0f - (1.0f - t) * (1.0f - t) * (1.0f - t);
				data.render_hrp_position = fade_start_hrp_position + (current_hrp_pos - fade_start_hrp_position) * ease_out;
				data.render_hrp_rotation = current_hrp_rot;
				data.parts_to_render = &fade_parts;
			}
			else if (data.use_fade_in)
			{
				auto current_time = std::chrono::steady_clock::now();
				auto elapsed_ms = std::chrono::duration_cast<std::chrono::milliseconds>(current_time - fade_start_time).count();
				data.fade_progress = static_cast<float>(elapsed_ms) / 300.0f;

				if (data.fade_progress >= 1.0f)
				{
					is_fading_in = false;
					data.fade_progress = 1.0f;
				}

				data.render_hrp_position = frozen_hrp_position;
				data.render_hrp_rotation = frozen_hrp_rotation;
				data.parts_to_render = &desync_parts;
			}
			else
			{
				data.render_hrp_position = frozen_hrp_position;
				data.render_hrp_rotation = frozen_hrp_rotation;
				data.parts_to_render = &desync_parts;
			}

			data.current_hrp_pos = current_hrp_pos;
			data.current_hrp_rot = current_hrp_rot;
			data.should_render = true;
			return data;
		}

		static void desync_thread()
		{
			using namespace std::chrono_literals;

			static keybind::keybind_t desync_kb{};
			static bool desync_active_state = false;

			for (;;)
			{
				std::this_thread::sleep_for(1ms);

				if (!settings::movement::desync::enabled)
				{
					if (desync_active_state)
					{
						memory->write<std::int32_t>(memory->m_base_address + Offsets::Desync::Pointer, 38760);
						desync_active_state = false;
						
						std::lock_guard<std::mutex> lock(frozen_data_mtx);
						if (!desync_parts.empty())
						{
							is_fading_out = true;
							fade_start_time = std::chrono::steady_clock::now();
							fade_start_hrp_position = frozen_hrp_position;
							fade_start_hrp_rotation = frozen_hrp_rotation;
							fade_parts = desync_parts;
						}
						desync_parts.clear();
						is_desync_active = false;
					}
					desync_kb.state = false;
					desync_kb.was_pressed = false;
					continue;
				}

				desync_kb.key = settings::movement::desync::keybind;
				desync_kb.mode = keybind::activation_mode::toggle;

				bool is_active = keybind::is_active(desync_kb);

				if (is_active != desync_active_state)
				{
					desync_active_state = is_active;

					if (is_active)
					{
						memory->write<std::int32_t>(memory->m_base_address + Offsets::Desync::Pointer, 1);
						
						std::lock_guard<std::mutex> lock(frozen_data_mtx);
						bool was_inactive = !is_desync_active;
						desync_parts.clear();
						is_fading_out = false;
						fade_parts.clear();
						
						if (was_inactive)
						{
							is_fading_in = true;
							fade_start_time = std::chrono::steady_clock::now();
						}

						cache::entity_t local_snapshot;
						{
							std::lock_guard<std::mutex> cache_lock(cache::mtx);
							local_snapshot = cache::local_player;
