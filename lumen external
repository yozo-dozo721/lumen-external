	if (ImGui::BeginPopup((std::string("keybind_mode_") + unique_id).c_str()))
	{
		ImGuiStyle& style = ImGui::GetStyle();
		
		if (ImAdd::SelectableLabel("Toggle", mode == activation_mode::toggle, true))
		{
