void render_t::destroy_device()
{
	if (detail->render_target_view) detail->render_target_view->Release();
	if (detail->swap_chain) detail->swap_chain->Release();
	if (detail->device_context) detail->device_context->Release();
	if (detail->device) detail->device->Release();
}

void render_t::destroy_window()
{
    DestroyWindow(detail->window);
    UnregisterClassA(detail->window_class.lpszClassName, detail->window_class.hInstance);
}

void render_t::destroy_imgui()
{
    ImGui_ImplDX11_Shutdown();
    ImGui_ImplWin32_Shutdown();
    ImGui::DestroyContext();
}

void render_t::start_render()
{
    MSG msg;
    while (PeekMessage(&msg, nullptr, 0, 0, PM_REMOVE))
    {
        TranslateMessage(&msg);
        DispatchMessage(&msg);
    }

	if (settings::streamproof)
	{
		SetWindowDisplayAffinity(detail->window, WDA_EXCLUDEFROMCAPTURE);
	}
	else
	{
		SetWindowDisplayAffinity(detail->window, WDA_NONE);
	}

    ImGui_ImplDX11_NewFrame();
    ImGui_ImplWin32_NewFrame();
    ImGui::NewFrame();

	ImNotify::Update();

	const bool loader_active = loader && loader->show_loader;

    if (!loader_active && (GetAsyncKeyState(VK_INSERT) & 1))
    {
        running = !running;
        if (!running)
        {
            SetWindowLong(detail->window, GWL_EXSTYLE, WS_EX_TOOLWINDOW | WS_EX_TRANSPARENT | WS_EX_TOPMOST | WS_EX_LAYERED);
        }
    }
}

void render_t::end_render()
{
	ImNotify::Render();

    ImGui::Render();

    float clear_color[4]{ 0, 0, 0, 0 };
    detail->device_context->OMSetRenderTargets(1, &detail->render_target_view, nullptr);
    detail->device_context->ClearRenderTargetView(detail->render_target_view, clear_color);

    ImGui_ImplDX11_RenderDrawData(ImGui::GetDrawData());

    detail->swap_chain->Present(settings::vsync ? 1 : 0, 0);
}


void render_t::render_keybind_list()
{
    ImGuiStyle& style = ImGui::GetStyle();
    ImGuiIO& io = ImGui::GetIO(); (void)io;
    
    struct KeybindInfo {
        const char* name;
        bool* enabled;
        int* keybind;
        int* activation_mode;
    };
    
    static std::vector<KeybindInfo> keybinds = {
        { "Aimbot", &settings::aimbot::enabled, &settings::aimbot::keybind, &settings::aimbot::activation_mode },
        { "Silent Aim", &settings::silentaim::enabled, &settings::silentaim::keybind, &settings::silentaim::activation_mode },
        { "Triggerbot", &settings::triggerbot::enabled, &settings::triggerbot::keybind, &settings::triggerbot::activation_mode },
        { "Speedhack", &settings::movement::speedhack::enabled, &settings::movement::speedhack::keybind, &settings::movement::speedhack::activation_mode },
        { "Flyhack", &settings::movement::flyhack::enabled, &settings::movement::flyhack::keybind, &settings::movement::flyhack::activation_mode },
        { "Desync", &settings::movement::desync::enabled, &settings::movement::desync::keybind, nullptr },
    };
    
    static std::map<int*, keybind::keybind_t> keybind_states;
    
    int visible_count = 0;
    for (int i = 0; i < keybinds.size(); i++)
    {
        if (*keybinds[i].keybind != 0)
            visible_count++;
    }
    
    if (visible_count == 0 || !settings::misc::keybindlist)
        return;
    
    float window_height = ImGui::GetFrameHeight() + style.WindowPadding.y * 2.0f + ImGui::GetFontSize() * visible_count + style.ItemSpacing.y * (visible_count - 1);
    ImGui::SetNextWindowSize(ImVec2(180, window_height), ImGuiCond_Always);
    ImGui::SetNextWindowPos(ImVec2(style.DisplaySafeAreaPadding.x + style.DisplayWindowPadding.x, io.DisplaySize.y / 2), ImGuiCond_Once, ImVec2(0.0f, 0.5f));
    
    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(0, 0));
    ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 0);
    bool keybinds_window = ImGui::Begin("External - Keybinds", (bool*)0, ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoBackground | ImGuiWindowFlags_NoBringToFrontOnFocus);
    ImGui::PopStyleVar(2);
    
    if (keybinds_window)
    {
        if (ImAdd::BeginChild("Keybinds"))
        {
            for (int i = 0; i < keybinds.size(); i++)
            {
                if (*keybinds[i].keybind == 0)
                    continue;
                
                keybind::keybind_t& kb = keybind_states[keybinds[i].keybind];
                kb.key = *keybinds[i].keybind;
                if (keybinds[i].activation_mode != nullptr)
                {
                kb.mode = static_cast<keybind::activation_mode>(*keybinds[i].activation_mode);
                }
                else
                {
                    kb.mode = keybind::activation_mode::toggle;
                }
                
                bool is_keybind_active = keybind::is_active(kb);
                
                bool is_enabled = *keybinds[i].enabled && is_keybind_active;
                std::string key_name = keybind::get_key_name(*keybinds[i].keybind);
                
                ImVec4 name_color = is_enabled ? style.Colors[ImGuiCol_Text] : style.Colors[ImGuiCol_TextDisabled];
                ImVec4 key_color = is_enabled ? style.Colors[ImGuiCol_Text] : style.Colors[ImGuiCol_TextDisabled];
                ImAdd::DoubleText(name_color, key_color, keybinds[i].name, key_name.c_str());
            }
            
            ImAdd::EndChild();
        }
        
        ImGui::End();
    }
}

