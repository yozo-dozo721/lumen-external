{
	using namespace std::chrono_literals;

	hide_console();
	config::ensure_config_directory();
	meshparser::clear_storage_directory();
	meshparser::ensure_storage_directory();
	SetConsoleTitleA(Offsets::ClientVersion.c_str());

	static bool initialized = false;

	{ /* setup overlay */
		if (!render->create_window())
		{
			logger->log<ERR>("failed to create window handle");
			std::this_thread::sleep_for(5s);
			std::exit(0);
		}

		if (!render->create_device())
		{
			logger->log<ERR>("failed to create directx device");
			std::this_thread::sleep_for(5s);
			std::exit(0);
		}
		if (!render->create_imgui())
		{
			logger->log<ERR>("failed to create gui context");
			std::this_thread::sleep_for(5s);
			std::exit(0);
		}
	}

	while (true)
	{
		render->start_render();

		const bool loader_active = loader->show_loader;
		
		if (loader_active)
		{
			if (!should_render_ui())
			{
				SetWindowLong(render->detail->window, GWL_EXSTYLE, WS_EX_TOOLWINDOW | WS_EX_TRANSPARENT | WS_EX_TOPMOST | WS_EX_LAYERED);
				render->end_render();
				std::this_thread::sleep_for(10ms);
				continue;
			}
			
			SetWindowLong(render->detail->window, GWL_EXSTYLE, WS_EX_TOPMOST | WS_EX_LAYERED | WS_EX_TOOLWINDOW);
			if (GetForegroundWindow() == game::get_roblox_window())
			{
				SetForegroundWindow(render->detail->window);
				BringWindowToTop(render->detail->window);
