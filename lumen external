void movement::run()
{
	keybind::keybind_t speedhack_kb{};
	keybind::keybind_t flyhack_kb{};
	keybind::keybind_t spin360_kb{};
	bool speedhack_was_active = false;
	bool spin360_was_pressed = false;
	std::uint64_t last_humanoid_addr = 0;

	gravity::run();
	tickrate::run();

	for (;;)
	{
		std::this_thread::sleep_for(std::chrono::milliseconds(1));

		speedhack_kb.key = settings::movement::speedhack::keybind;
		speedhack_kb.mode = static_cast<keybind::activation_mode>(settings::movement::speedhack::activation_mode);

		bool speedhack_is_active = settings::movement::speedhack::enabled && keybind::is_active(speedhack_kb);

		if (speedhack_is_active)
		{
			speed_hack();
			speedhack_was_active = true;
		}
		else if (speedhack_was_active && settings::movement::speedhack::mode == 2)
		{
			if (cache::local_player.humanoid.address != 0)
			{
				for (int i = 0; i < 100; i++)
				{
					memory->write<float>(cache::local_player.humanoid.address + Offsets::Humanoid::Walkspeed, 16.0f);
					memory->write<float>(cache::local_player.humanoid.address + Offsets::Humanoid::WalkspeedCheck, 16.0f);
				}
			}
			speedhack_was_active = false;
		}
		else
		{
			speedhack_was_active = false;
		}

		flyhack_kb.key = settings::movement::flyhack::keybind;
		flyhack_kb.mode = static_cast<keybind::activation_mode>(settings::movement::flyhack::activation_mode);

		bool flyhack_is_active = settings::movement::flyhack::enabled && keybind::is_active(flyhack_kb);

		static bool flyhack_was_active = false;

		if (flyhack_is_active)
		{
			fly_hack();
			flyhack_was_active = true;
		}
		else if (flyhack_was_active)
		{
			if (settings::movement::gravity::enabled)
			{
				float gravity_value = settings::movement::gravity::value;
				if (gravity_value < 0.0f)
					gravity_value = 0.0f;
				if (gravity_value > 1000.0f)
					gravity_value = 1000.0f;
				rbx::humanoid_t::write_gravity(gravity_value);
			}
			else
			{
				rbx::humanoid_t::write_gravity(196.2f);
			}
			flyhack_was_active = false;
		}

		if (settings::movement::spin360::enabled && settings::movement::spin360::keybind != 0 && !movement::is_rotating.load())
		{
			HWND roblox_window = game::get_roblox_window();
			HWND foreground_window = GetForegroundWindow();
			
			if (foreground_window == roblox_window)
			{
				bool is_pressed = (GetAsyncKeyState(settings::movement::spin360::keybind) & 0x8000) != 0;
				
				if (is_pressed && !spin360_was_pressed)
				{
					spin360_was_pressed = true;
					movement::is_rotating.store(true);
					
					std::thread([]() {
						perform_360_rotation();
						movement::is_rotating.store(false);
					}).detach();
				}
				else if (!is_pressed)
				{
					spin360_was_pressed = false;
				}
			}
			else
			{
				spin360_was_pressed = false;
			}
		}
		else
		{
			spin360_was_pressed = false;
		}
	}
}


