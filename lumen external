					render->running = true;
					SetWindowLong(render->detail->window, GWL_EXSTYLE, WS_EX_TOOLWINDOW | WS_EX_TRANSPARENT);
				}
			}
		}
		else
		{
			if (!should_render_ui())
			{
				SetWindowLong(render->detail->window, GWL_EXSTYLE, WS_EX_TOOLWINDOW | WS_EX_TRANSPARENT | WS_EX_TOPMOST | WS_EX_LAYERED);
