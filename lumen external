				}
				else if (desync_data.use_fade_in)
				{
					float ease_in = desync_data.fade_progress * desync_data.fade_progress * desync_data.fade_progress;
					alpha_mult = ease_in;
				}

				ImU32 cham_fill_col = IM_COL32(
					static_cast<int>(settings::movement::desync::cham_colour[0] * 255.f),
