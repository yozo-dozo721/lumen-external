local imgui
for _, name in ipairs({ "imgui", "cimgui", "imgui_lua", "imgui.imgui" }) do
    local ok, mod = pcall(require, name)
    if ok and mod and mod.Begin then imgui = mod; break end
end
if not imgui then
    error("No ImGui Lua binding found. Install cimgui-lua, imgui_lua, " ..
          "or expose 'imgui' as a global before requiring this file.")
end

