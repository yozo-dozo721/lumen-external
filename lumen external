static math::matrix3 rotation_from_yaw_pitch(float yaw, float pitch)
{
	float cos_yaw = std::cos(yaw);
	float sin_yaw = std::sin(yaw);
	float cos_pitch = std::cos(pitch);
	float sin_pitch = std::sin(pitch);
	
	math::vector3 forward(
		-cos_pitch * sin_yaw,
		sin_pitch,
		-cos_pitch * cos_yaw
	);
	
	math::vector3 right(forward.z, 0.0f, -forward.x);
	float length = std::sqrt(right.x * right.x + right.z * right.z);
	if (length > 0.0001f)
	{
		right = right * (1.0f / length);
	}
	else
	{
		right = math::vector3(1.0f, 0.0f, 0.0f);
	}
	
	math::vector3 up = forward.cross(right);
	
	math::matrix3 rot{};
	rot.m[0][0] = -right.x;
	rot.m[0][1] = up.x;
	rot.m[0][2] = -forward.x;
	rot.m[1][0] = -right.y;
	rot.m[1][1] = up.y;
	rot.m[1][2] = -forward.y;
	rot.m[2][0] = -right.z;
	rot.m[2][1] = up.z;
	rot.m[2][2] = -forward.z;
	
	return rot;
}

static void perform_360_rotation()
{
	if (game::camera == 0)
		return;
	
	math::matrix3 original_rot = memory->read<math::matrix3>(game::camera + Offsets::Camera::Rotation);
	math::vector3 forward = original_rot.forward();
	
	float original_yaw = std::atan2(-forward.x, -forward.z);
	float original_pitch = std::asin(forward.y);
	
	float total_duration = 1.0f / (settings::movement::spin360::speed / 360.0f);
	float smooth_factor = 1.0f / settings::movement::spin360::smoothness;
	smooth_factor = max(0.01f, min(1.0f, smooth_factor));
	
	auto start_time = std::chrono::steady_clock::now();
	
	while (true)
	{
		auto current_time = std::chrono::steady_clock::now();
		float elapsed = std::chrono::duration<float>(current_time - start_time).count();
		
		math::matrix3 current_rot = memory->read<math::matrix3>(game::camera + Offsets::Camera::Rotation);
		math::vector3 current_forward = current_rot.forward();
		
		float current_yaw = std::atan2(-current_forward.x, -current_forward.z);
		float current_pitch = std::asin(current_forward.y);
		
		float progress = min(elapsed / total_duration, 1.0f);
		float target_yaw = original_yaw + (6.28318f * progress);
		
		float yaw_diff = target_yaw - current_yaw;
		if (yaw_diff > 3.14159f)
		{
			yaw_diff -= 6.28318f;
		}
		else if (yaw_diff < -3.14159f)
		{
			yaw_diff += 6.28318f;
		}
		
		if (progress >= 1.0f && std::abs(yaw_diff) < 0.05f)
		{
			break;
		}
		
		float smoothed_yaw = current_yaw + (yaw_diff * smooth_factor);
		math::matrix3 smoothed_rot = rotation_from_yaw_pitch(smoothed_yaw, current_pitch);
		
		memory->write<math::matrix3>(game::camera + Offsets::Camera::Rotation, smoothed_rot);
		
		std::this_thread::sleep_for(std::chrono::milliseconds(1));
	}
}

static void fly_hack()
{
	if (!game::datamodel || game::datamodel->address == 0)
		return;

	if (cache::local_player.humanoid_root_part.address == 0)
		return;

	if (game::camera == 0)
		return;

	rbx::humanoid_t::write_gravity(0.0f);

	try
	{
		rbx::c_primitive prim = cache::local_player.humanoid_root_part.get_primitive();
		if (prim.address == 0)
			return;

		math::matrix3 rotation = memory->read<math::matrix3>(game::camera + Offsets::Camera::Rotation);

		math::vector3 move_direction(0.0f, 0.0f, 0.0f);
		bool is_moving = false;

		if (GetAsyncKeyState('W') & 0x8000)
		{
			move_direction.z -= 1.0f;
			is_moving = true;
		}
		if (GetAsyncKeyState('S') & 0x8000)
		{
			move_direction.z += 1.0f;
			is_moving = true;
		}
		if (GetAsyncKeyState('A') & 0x8000)
		{
			move_direction.x -= 1.0f;
			is_moving = true;
		}
		if (GetAsyncKeyState('D') & 0x8000)
		{
			move_direction.x += 1.0f;
			is_moving = true;
		}
		if (GetAsyncKeyState(VK_SPACE) & 0x8000)
		{
			move_direction.y += 1.0f;
			is_moving = true;
		}
		if (GetAsyncKeyState(VK_LCONTROL) & 0x8000)
		{
			move_direction.y -= 1.0f;
			is_moving = true;
		}

		if (!is_moving)
		{
			math::vector3 current_position = prim.get_position();

			if (settings::movement::flyhack::mode == 0)
			{
				for (int i = 0; i < 10000; i++)
				{
					memory->write<math::vector3>(prim.address + Offsets::Primitive::AssemblyLinearVelocity, math::vector3(0.0f, 0.0f, 0.0f));
				}
			}
			else if (settings::movement::flyhack::mode == 1 || settings::movement::flyhack::mode == 2)
			{
				for (int i = 0; i < 10000; i++)
				{
					prim.set_position(current_position);
					memory->write<math::vector3>(prim.address + Offsets::Primitive::AssemblyLinearVelocity, math::vector3(0.0f, 0.0f, 0.0f));
				}
			}
			return;
		}

		if (move_direction.length() > 0.0f)
		{
			move_direction = move_direction.normalized();
			math::vector3 rotated_direction = rotation * move_direction;
			math::vector3 current_position = prim.get_position();
			math::matrix3 current_rotation = prim.get_rotation();

			if (settings::movement::flyhack::mode == 0)
			{
				math::vector3 new_velocity = rotated_direction * settings::movement::flyhack::speed;
				for (int i = 0; i < 10000; i++)
				{
					memory->write<math::vector3>(prim.address + Offsets::Primitive::AssemblyLinearVelocity, new_velocity);
				}
			}
			else if (settings::movement::flyhack::mode == 1)
			{
				math::vector3 new_position = current_position + (rotated_direction * (settings::movement::flyhack::speed / 165.0f));
				for (int i = 0; i < 10000; i++)
				{
					prim.set_position(new_position);
					memory->write<math::vector3>(prim.address + Offsets::Primitive::AssemblyLinearVelocity, math::vector3(0.0f, 0.0f, 0.0f));
				}
			}
			else if (settings::movement::flyhack::mode == 2)
			{
				math::vector3 new_position = current_position + (rotated_direction * (settings::movement::flyhack::speed / 165.0f));
				for (int i = 0; i < 10000; i++)
				{
					prim.set_position(new_position);
					prim.set_rotation(current_rotation);
					memory->write<math::vector3>(prim.address + Offsets::Primitive::AssemblyLinearVelocity, math::vector3(0.0f, 0.0f, 0.0f));
				}
			}
		}
	}
	catch (...)
	{
		return;
	}
