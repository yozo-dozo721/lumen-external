enum e_level
{
	INFO,
	WARN,
	ERR,

	DEBUG, // only prints if _DEBUG is defined
};

class c_logger final
{
private:
	static constexpr std::uint8_t TIME_BUF_LEN = 9;
public:
	c_logger()
	{
		HANDLE hOut = GetStdHandle(STD_OUTPUT_HANDLE);
		if (hOut != INVALID_HANDLE_VALUE) {
			DWORD dwMode = 0;
			GetConsoleMode(hOut, &dwMode);
			dwMode |= ENABLE_VIRTUAL_TERMINAL_PROCESSING;
			SetConsoleMode(hOut, dwMode);
		}
	}

	template <e_level level, class... types>
	inline void log(const std::format_string<types...> format, types&&... args)
	{
		const char* color{};
		const char* label{};
		ImVec4 imgui_color{};

		if constexpr (level == e_level::INFO) { 
			color = "\x1b[92m"; 
			label = "INFO"; 
			imgui_color = ImVec4(0.57f, 1.0f, 0.57f, 1.0f);
		}
		else if constexpr (level == e_level::WARN) { 
			color = "\x1b[33m"; 
			label = "WARN"; 
			imgui_color = ImVec4(1.0f, 0.84f, 0.0f, 1.0f);
		}
		else if constexpr (level == e_level::ERR) { 
			color = "\x1b[31m"; 
			label = "ERR!"; 
			imgui_color = ImVec4(1.0f, 0.3f, 0.3f, 1.0f);
		}
#ifdef _DEBUG
		else if constexpr (level == e_level::DEBUG) { 
			color = "\x1b[94m"; 
			label = "DBG!"; 
			imgui_color = ImVec4(0.5f, 0.7f, 1.0f, 1.0f);
		}
#endif
		else return;

		auto now{ std::chrono::system_clock::now() };
		std::time_t t{ std::chrono::system_clock::to_time_t(now) };
		std::tm tm{};
		localtime_s(&tm, &t);

		std::array<char, TIME_BUF_LEN> time_buf{};
		std::strftime(time_buf.data(), time_buf.size(), "%H:%M:%S", &tm);

		std::string formatted_msg = std::format(format, std::forward<types>(args)...);
		std::string full_msg = std::format("[{}] {}", label, formatted_msg);

		HANDLE hOut = GetStdHandle(STD_OUTPUT_HANDLE);
		if (hOut != INVALID_HANDLE_VALUE) {
			std::print("{}[{}][{}]\033[0m ", color, time_buf.data(), label);
			std::println("{}", formatted_msg);
			std::fflush(stdout);
		}
	}

	template <e_level level, class... types>
