-- ---- KeyBind -------------------------------------------------------------
function ImAdd.KeyBind(str_id, key, w, h)
    local name = "Unbound"
    if key ~= 0 and I.GetKeyName then name = I.GetKeyName(key) end
    w = w or 140
    h = h or (I.GetFrameHeight and I.GetFrameHeight() or 24)

    local pos_x, pos_y = I.GetCursorScreenPos()
    local p = I.InvisibleButton(str_id .. "##kb", w, h)
    local active = I.IsItemActive()
    local dl = I.GetWindowDrawList()
    local bg = active and { 0.32,0.38,0.48,1 } or { 0.20,0.23,0.29,1 }
    dl:AddRectFilled(pos_x, pos_y, pos_x + w, pos_y + h, ColorU32(RGB(bg[1],bg[2],bg[3],bg[4])), 6)
    dl:AddRect(pos_x, pos_y, pos_x + w, pos_y + h, ColorU32(RGB(0.20,0.22,0.26,1)), 6, 0, 1)
    dl:AddText(pos_x + 10, pos_y + (h - I.GetFontSize()) * 0.5,
               ColorU32(RGB(0.92,0.93,0.95,1)), active and "..." or name)

    local changed = false
    if active and I.IsKeyPressed and I.GetIO then
        -- Scan a small set of keys for a new bind
        for _, k in ipairs(K and K.NamedKey_BEGIN and { K.F1, K.F2, K.F3, K.F4, K.F5, K.F6 } or {}) do
            if I.IsKeyPressed(k) then key = k; changed = true; break end
        end
    end
    return changed, key
end

-- ---- Color helpers -------------------------------------------------------
function ImAdd.SliderAlpha(str_id, col)
    I.TextUnformatted("Alpha")
    I.SetNextItemWidth and I.SetNextItemWidth(-1)
    local changed, v = I.SliderFloat("##alpha_" .. str_id, col.a, 0.0, 1.0, "%.2f")
    if changed then col.a = v end
    return changed
end

function ImAdd.SliderHue(str_id, col)
    I.TextUnformatted("Hue")
    I.SetNextItemWidth and I.SetNextItemWidth(-1)
    local h, s, v = 0, 0, 0
    if I.ColorConvertRGBtoHSV then
        h, s, v = I.ColorConvertRGBtoHSV(col.r, col.g, col.b)
    end
    local changed, nh = I.SliderFloat("##hue_" .. str_id, h, 0.0, 1.0, "%.2f")
    if changed and I.ColorConvertHSVtoRGB then
        col.r, col.g, col.b = I.ColorConvertHSVtoRGB(nh, s, v)
    end
    return changed
end

-- ---- ColorEdit4 (uses our palette + sliders) -----------------------------
function ImAdd.ColorEdit4(label, col)
    I.TextUnformatted(label)
    local changed = false

    I.TextDisabled("RGBA")
    I.SetNextItemWidth and I.SetNextItemWidth(-1)
    local c1, r = I.SliderFloat("R##" .. label, col.r, 0, 1, "%.2f"); changed = changed or c1; col.r = r
    local c2, g = I.SliderFloat("G##" .. label, col.g, 0, 1, "%.2f"); changed = changed or c2; col.g = g
    local c3, b = I.SliderFloat("B##" .. label, col.b, 0, 1, "%.2f"); changed = changed or c3; col.b = b
    local c4, a = I.SliderFloat("A##" .. label, col.a, 0, 1, "%.2f"); changed = changed or c4; col.a = a

    ImAdd.SliderHue(label, col)

    return changed
end

-- ---- BeginChild / EndChild (framed with title bar) -----------------------
function ImAdd.BeginChild(label, w, h)
    w = w or 0; h = h or 0
    local pw, ph = I.GetWindowPos()
    I.BeginChild("##framed_" .. label, w, h, true)
    local dl = I.GetWindowDrawList()
    local cx, cy = I.GetWindowPos()
    local cw, ch = I.GetWindowSize()
    dl:AddRectFilled(cx, cy, cx + cw, cy + 30, ColorU32(RGB(0.14,0.15,0.18,1)), 6, 1)
    dl:AddText(cx + 10, cy + 8, ColorU32(RGB(0.92,0.93,0.95,1)), label)
    I.SetCursorPosY(30)
    I.BeginChild("##framed_body_" .. label, 0, 0, false)
end

function ImAdd.EndChild()
    I.EndChild()
    I.EndChild()
end

-- ---- RenderSubTabs -------------------------------------------------------
function ImAdd.RenderSubTabs(labels, current)
    local total_w = I.GetContentRegionAvail()
    local w_each  = total_w / #labels
    local changed = false
    for i, name in ipairs(labels) do
        if i > 1 then I.SameLine() end
        local active = (current == i - 1)
        if ImAdd.Tab(name, active and 0 or -1, 0, 0, w_each, 32) then
            current = i - 1; changed = true
        end
    end
    return changed, current
end

