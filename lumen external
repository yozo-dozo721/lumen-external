	bool parse_mesh(const std::string& file_path, parsed_mesh& mesh)
	{
		std::ifstream file(file_path, std::ios::binary);
		if (!file.is_open())
			return false;
		
		file.seekg(0, std::ios::end);
		size_t file_size = file.tellg();
		file.seekg(0, std::ios::beg);
		
		std::vector<uint8_t> data(file_size);
		file.read(reinterpret_cast<char*>(data.data()), file_size);
		file.close();
		
		if (data.size() < 12)
			return false;
		
		std::string version = get_mesh_version(data);
		if (version.empty())
			return false;
		
		mesh.version = version;
		
		size_t offset = 0;
		for (size_t i = 0; i < data.size(); i++)
		{
			if (data[i] == '\n')
			{
				offset = i + 1;
				break;
			}
		}
		
		if (offset == 0)
			return false;
		
		if (version == "1.00")
		{
			return parse_mesh_v1(data, offset, mesh, 0.5f, true);
		}
		else if (version == "1.01")
		{
			return parse_mesh_v1(data, offset, mesh, 1.0f, false);
		}
		else if (version == "2.00")
		{
			return parse_mesh_v2(data, offset, mesh);
		}
		else if (version == "3.00" || version == "3.01")
		{
			return parse_mesh_v3(data, offset, mesh);
		}
		else if (version == "4.00" || version == "4.01")
		{
			return parse_mesh_v4(data, offset, mesh);
		}
		else if (version == "5.00" || version == "5.01")
		{
			return parse_mesh_v5(data, offset, mesh);
		}
		else if (version == "6.00" || version == "7.00")
		{
			return parse_mesh_v5(data, offset, mesh);
		}
		
		return false;
	}

	bool save_parsed_mesh(const std::string& name, const parsed_mesh& mesh)
	{
		if (!ensure_storage_directory())
			return false;
		
		std::string path = get_mesh_path(name);
		if (path.empty())
			return false;
		
		json j;
		j["version"] = mesh.version;
		j["num_vertices"] = mesh.num_vertices;
		j["num_faces"] = mesh.num_faces;
		
		json vertices_array = json::array();
		for (const auto& vertex : mesh.vertices)
		{
			json v;
			v["position"] = { vertex.position.x, vertex.position.y, vertex.position.z };
			v["normal"] = { vertex.normal.x, vertex.normal.y, vertex.normal.z };
			v["uv"] = { vertex.uv.x, vertex.uv.y };
			v["tangent"] = { vertex.tangent.x, vertex.tangent.y, vertex.tangent.z };
			v["color"] = { vertex.r, vertex.g, vertex.b, vertex.a };
			vertices_array.push_back(v);
		}
		j["vertices"] = vertices_array;
		
		json faces_array = json::array();
		for (const auto& face : mesh.faces)
		{
			json f;
			f["indices"] = { face.a, face.b, face.c };
			faces_array.push_back(f);
		}
		j["faces"] = faces_array;
		
		if (!mesh.lods.empty())
		{
			j["lods"] = mesh.lods;
		}
		
		std::ofstream file(path);
		if (!file.is_open())
			return false;
		
		file << j.dump(4);
		file.close();
		return true;
	}

	bool load_parsed_mesh(const std::string& name, parsed_mesh& mesh)
	{
		std::string path = get_mesh_path(name);
		if (path.empty() || !std::filesystem::exists(path))
			return false;
		
		std::ifstream file(path);
		if (!file.is_open())
			return false;
		
		json j;
		try
		{
			file >> j;
		}
		catch (...)
		{
			file.close();
			return false;
		}
		file.close();
		
		mesh.version = j.value("version", "");
		mesh.num_vertices = j.value("num_vertices", 0u);
		mesh.num_faces = j.value("num_faces", 0u);
		
		mesh.vertices.clear();
		if (j.contains("vertices") && j["vertices"].is_array())
		{
			for (const auto& v : j["vertices"])
			{
				mesh_vertex vertex;
				if (v.contains("position") && v["position"].is_array() && v["position"].size() >= 3)
				{
					vertex.position.x = v["position"][0];
					vertex.position.y = v["position"][1];
					vertex.position.z = v["position"][2];
				}
				if (v.contains("normal") && v["normal"].is_array() && v["normal"].size() >= 3)
				{
					vertex.normal.x = v["normal"][0];
					vertex.normal.y = v["normal"][1];
					vertex.normal.z = v["normal"][2];
				}
				if (v.contains("uv") && v["uv"].is_array() && v["uv"].size() >= 2)
				{
					vertex.uv.x = v["uv"][0];
					vertex.uv.y = v["uv"][1];
				}
				if (v.contains("tangent") && v["tangent"].is_array() && v["tangent"].size() >= 3)
				{
					vertex.tangent.x = v["tangent"][0];
					vertex.tangent.y = v["tangent"][1];
					vertex.tangent.z = v["tangent"][2];
				}
				if (v.contains("color") && v["color"].is_array() && v["color"].size() >= 4)
				{
					vertex.r = v["color"][0];
					vertex.g = v["color"][1];
					vertex.b = v["color"][2];
					vertex.a = v["color"][3];
				}
				mesh.vertices.push_back(vertex);
			}
		}
		
		mesh.faces.clear();
		if (j.contains("faces") && j["faces"].is_array())
		{
			for (const auto& f : j["faces"])
			{
				mesh_face face;
				if (f.contains("indices") && f["indices"].is_array() && f["indices"].size() >= 3)
				{
					face.a = f["indices"][0];
					face.b = f["indices"][1];
					face.c = f["indices"][2];
				}
				mesh.faces.push_back(face);
			}
		}
		
		mesh.lods.clear();
		if (j.contains("lods") && j["lods"].is_array())
		{
			for (const auto& lod : j["lods"])
			{
				mesh.lods.push_back(lod);
			}
		}
		
		return true;
	}

