c_loader::c_loader() {
	load_saved_credentials();
	fade_in();

	if (remember_me && strlen(username_buf) > 0 && strlen(password_buf) > 0) {
		std::thread([this]() {
			std::this_thread::sleep_for(std::chrono::milliseconds(100));
			if (attempt_login()) {
				fade_out();
			}
			}).detach();
	}
}

std::string c_loader::get_auth_path() const {
	char appdata_path[MAX_PATH];
	if (SUCCEEDED(SHGetFolderPathA(NULL, CSIDL_APPDATA, NULL, SHGFP_TYPE_CURRENT, appdata_path))) {
		return std::string(appdata_path) + "\\Lumen\\Auth\\auth.json";
	}
	return {};
}

void c_loader::load_saved_credentials() {
	std::string key_path = get_auth_path();
	if (key_path.empty() || !std::filesystem::exists(key_path)) {
		return;
	}

	if (check_json_key(key_path, "username") && check_json_key(key_path, "password")) {
		std::string username = read_json(key_path, "username");
		std::string password = read_json(key_path, "password");
		strncpy_s(username_buf, sizeof(username_buf), username.c_str(), _TRUNCATE);
		strncpy_s(password_buf, sizeof(password_buf), password.c_str(), _TRUNCATE);
		remember_me = true;
	}
}

void c_loader::save_credentials() {
	if (!remember_me) {
		return;
	}

	std::string key_path = get_auth_path();
	if (key_path.empty()) {
		return;
	}

	std::filesystem::create_directories(std::filesystem::path(key_path).parent_path());
	write_json(key_path, "username", std::string(username_buf), true, "password", std::string(password_buf));
}


bool c_loader::attempt_login() {
	if (is_authenticating) {
		return false;
	}

	is_authenticating = true;

	auto& KeyAuthApp = keyauth->get_app();
	KeyAuthApp.init();

	if (!KeyAuthApp.response.success) {
		std::string error_msg = KeyAuthApp.response.message.empty() ? "Initialization failed" : KeyAuthApp.response.message;
		ImNotify::Print(NotifyLevel::Error, error_msg.c_str());
		logger->log<ERR>("[auth] status: {}", error_msg);
		is_authenticating = false;
		return false;
	}

	std::string username(username_buf);
	std::string password(password_buf);
	std::string code(show_2fa_input ? code_buf : "");

	if (username.empty() || password.empty()) {
		ImNotify::Print(NotifyLevel::Error, "Please enter username and password");
		logger->log<ERR>("[auth] please enter username and password");
		is_authenticating = false;
		return false;
	}

	if (show_2fa_input && !code.empty()) {
		KeyAuthApp.login(username, password, code);
	}
	else {
		KeyAuthApp.login(username, password);
	}

	if (KeyAuthApp.response.message.empty()) {
		ImNotify::Print(NotifyLevel::Error, "Authentication failed");
		logger->log<ERR>("[auth] authentication failed");
		is_authenticating = false;
		return false;
	}

	if (!KeyAuthApp.response.success) {
		if (KeyAuthApp.response.message == "2FA code required.") {
			show_2fa_input = true;
			ImNotify::Print(NotifyLevel::Warn, "2FA code required");
			logger->log<WARN>("[auth] 2FA code required");
			is_authenticating = false;
			return false;
		}
		else {
			ImNotify::Print(NotifyLevel::Error, KeyAuthApp.response.message.c_str());
			logger->log<ERR>("[auth] {}", KeyAuthApp.response.message);
			if (remember_me) {
				std::string key_path = get_auth_path();
				if (!key_path.empty() && std::filesystem::exists(key_path)) {
					std::remove(key_path.c_str());
				}
			}
			is_authenticating = false;
			return false;
		}
	}

	if (remember_me) {
		save_credentials();
	}

	std::thread run(check_auth, keyauth->get_ownerid());
	std::thread check([&]() { keyauth->session_status(); });

	run.detach();
	check.detach();

	authenticated = true;
	ImNotify::Print(NotifyLevel::Success, "Login successful");
	is_authenticating = false;
	return true;
}


void c_loader::fade_in() {
	is_fading_in = true;
	is_fading_out = false;
	fade_start_time = std::chrono::steady_clock::now();
	loader_alpha = 0.0f;
}

void c_loader::fade_out() {
	is_fading_out = true;
	is_fading_in = false;
	fade_start_time = std::chrono::steady_clock::now();
}

bool c_loader::is_fading() const {
	return is_fading_in || is_fading_out;
}

void c_loader::render_loader() {
	if (!show_loader) {
		return;
	}

	auto current_time = std::chrono::steady_clock::now();
	auto elapsed = std::chrono::duration<float>(current_time - fade_start_time).count();

	if (is_fading_in) {
		loader_alpha = (std::min)(1.0f, elapsed / fade_duration);
		if (loader_alpha >= 1.0f) {
			is_fading_in = false;
		}
	}
	else if (is_fading_out) {
		loader_alpha = (std::max)(0.0f, 1.0f - (elapsed / fade_duration));
		if (loader_alpha <= 0.0f) {
			show_loader = false;
			is_fading_out = false;
		}
	}
	else if (!authenticated) {
		loader_alpha = 1.0f;
	}

	if (loader_alpha <= 0.0f) {
		return;
	}

	ImGuiStyle& style = ImGui::GetStyle();
	ImGuiIO& io = ImGui::GetIO();

	ImGui::PushStyleVar(ImGuiStyleVar_Alpha, loader_alpha);

