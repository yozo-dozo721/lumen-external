	static std::string get_mesh_id_string(uint64_t part_address)
	{
		if (part_address == 0)
			return "";
		
		std::string class_name = rbx::c_instance(part_address).get_class_name();
		if (class_name != "MeshPart")
			return "";
		
		uint64_t mesh_id_ptr = memory->read<uint64_t>(part_address + Offsets::MeshPart::MeshId);
		
		if (mesh_id_ptr == 0)
		{
			std::string mesh_id_direct = memory->read_string(part_address + Offsets::MeshPart::MeshId);
			if (mesh_id_direct != "str_error" && !mesh_id_direct.empty())
			{
				return mesh_id_direct;
			}
			return "";
		}
		
		std::string mesh_id = memory->read_string(mesh_id_ptr);
		
		if (mesh_id == "str_error")
		{
			std::string mesh_id_direct = memory->read_string(part_address + Offsets::MeshPart::MeshId);
			if (mesh_id_direct != "str_error" && !mesh_id_direct.empty())
			{
				return mesh_id_direct;
			}
			return "";
		}
		
		if (mesh_id.empty())
		{
			return "";
		}
		
		return mesh_id;
	}

	static uint64_t extract_asset_id(const std::string& mesh_id_string)
	{
		if (mesh_id_string.find("rbxassetid://") == 0)
		{
			std::string id_str = mesh_id_string.substr(13);
			try
			{
				return std::stoull(id_str);
			}
			catch (...)
			{
				return 0;
			}
		}
		else if (mesh_id_string.find("rbxasset://") == 0)
		{
			std::string id_str = mesh_id_string.substr(11);
			try
			{
				return std::stoull(id_str);
			}
			catch (...)
			{
				return 0;
			}
		}
		else if (mesh_id_string.find("https://assetdelivery.roblox.com") != std::string::npos)
		{
			size_t id_pos = mesh_id_string.find("?id=");
			if (id_pos != std::string::npos)
			{
				std::string id_str = mesh_id_string.substr(id_pos + 4);
				size_t end_pos = id_str.find_first_of("& \n\r\t");
				if (end_pos != std::string::npos)
				{
					id_str = id_str.substr(0, end_pos);
				}
				try
				{
					return std::stoull(id_str);
				}
				catch (...)
				{
					return 0;
				}
			}
		}
		
		return 0;
	}

	static bool download_from_url(const std::wstring& host, const std::wstring& path, std::vector<uint8_t>& data, bool accept_gzip = true)
	{
		HINTERNET hSession = WinHttpOpen(L"Lumen/1.0", WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);
		if (!hSession)
			return false;
		
		HINTERNET hConnect = WinHttpConnect(hSession, host.c_str(), INTERNET_DEFAULT_HTTPS_PORT, 0);
		if (!hConnect)
		{
			WinHttpCloseHandle(hSession);
			return false;
		}
		
		HINTERNET hRequest = WinHttpOpenRequest(hConnect, L"GET", path.c_str(), NULL, WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES, WINHTTP_FLAG_SECURE);
		if (!hRequest)
		{
			WinHttpCloseHandle(hConnect);
			WinHttpCloseHandle(hSession);
			return false;
		}
		
		WinHttpAddRequestHeaders(hRequest, L"Accept-Encoding: identity", -1, WINHTTP_ADDREQ_FLAG_REPLACE | WINHTTP_ADDREQ_FLAG_ADD);
		
		bool success = WinHttpSendRequest(hRequest, WINHTTP_NO_ADDITIONAL_HEADERS, 0, WINHTTP_NO_REQUEST_DATA, 0, 0, 0) != FALSE;
		if (!success)
		{
			WinHttpCloseHandle(hRequest);
			WinHttpCloseHandle(hConnect);
			WinHttpCloseHandle(hSession);
			return false;
		}
		
		success = WinHttpReceiveResponse(hRequest, NULL) != FALSE;
		if (!success)
		{
			WinHttpCloseHandle(hRequest);
			WinHttpCloseHandle(hConnect);
			WinHttpCloseHandle(hSession);
			return false;
		}
		
		DWORD status_code = 0;
		DWORD status_code_size = sizeof(status_code);
		if (WinHttpQueryHeaders(hRequest, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, NULL, &status_code, &status_code_size, NULL))
		{
			if (status_code != 200)
			{
				WinHttpCloseHandle(hRequest);
				WinHttpCloseHandle(hConnect);
				WinHttpCloseHandle(hSession);
				return false;
			}
		}
		
		std::wstring content_encoding;
		DWORD header_size = 0;
		WinHttpQueryHeaders(hRequest, WINHTTP_QUERY_CONTENT_ENCODING, NULL, NULL, &header_size, WINHTTP_HEADER_NAME_BY_INDEX);
		if (header_size > 0)
		{
			std::vector<wchar_t> header_buffer(header_size / sizeof(wchar_t));
			if (WinHttpQueryHeaders(hRequest, WINHTTP_QUERY_CONTENT_ENCODING, NULL, header_buffer.data(), &header_size, WINHTTP_HEADER_NAME_BY_INDEX))
			{
				content_encoding = header_buffer.data();
			}
		}
		
		DWORD dwSize = 0;
		DWORD dwDownloaded = 0;
		std::vector<uint8_t> compressed_data;
		
		do
		{
			dwSize = 0;
			if (!WinHttpQueryDataAvailable(hRequest, &dwSize))
				break;
			
			if (dwSize == 0)
				break;
			
			std::vector<uint8_t> buffer(dwSize);
			if (!WinHttpReadData(hRequest, buffer.data(), dwSize, &dwDownloaded))
				break;
			
			if (dwDownloaded > 0)
			{
				compressed_data.insert(compressed_data.end(), buffer.begin(), buffer.begin() + dwDownloaded);
			}
		} while (dwSize > 0);
		
		WinHttpCloseHandle(hRequest);
		WinHttpCloseHandle(hConnect);
		WinHttpCloseHandle(hSession);
		
		if (compressed_data.empty())
			return false;
		
		if (content_encoding.find(L"gzip") != std::wstring::npos || 
		    (compressed_data.size() >= 2 && compressed_data[0] == 0x1f && compressed_data[1] == 0x8b))
		{
			if (compressed_data.size() < 10)
			{
				logger->log<DEBUG>("[mesh] gzip data too small");
				return false;
			}
			
			size_t gzip_header_size = 10;
			if (compressed_data[3] & 0x04)
				gzip_header_size += 2;
			if (compressed_data[3] & 0x08)
			{
				while (gzip_header_size < compressed_data.size() && compressed_data[gzip_header_size] != 0)
					gzip_header_size++;
				gzip_header_size++;
			}
			if (compressed_data[3] & 0x10)
			{
				while (gzip_header_size < compressed_data.size() && compressed_data[gzip_header_size] != 0)
					gzip_header_size++;
				gzip_header_size++;
			}
			if (compressed_data[3] & 0x02)
				gzip_header_size += 2;
			
			if (gzip_header_size >= compressed_data.size() - 8)
			{
				logger->log<DEBUG>("[mesh] invalid gzip header");
				return false;
			}
			
			std::vector<uint8_t> deflate_data(compressed_data.begin() + gzip_header_size, compressed_data.end() - 8);
			
			int outlen = 0;
			char* decompressed = stbi_zlib_decode_noheader_malloc(
				reinterpret_cast<const char*>(deflate_data.data()),
				static_cast<int>(deflate_data.size()),
				&outlen
			);
			
			if (decompressed && outlen > 0)
			{
				data.assign(reinterpret_cast<uint8_t*>(decompressed), reinterpret_cast<uint8_t*>(decompressed) + outlen);
				free(decompressed);
				logger->log<DEBUG>("[mesh] decompressed {}->{} bytes", compressed_data.size(), data.size());
				return true;
			}
			else
			{
				if (decompressed)
					free(decompressed);
				logger->log<DEBUG>("[mesh] gzip decompression failed");
				return false;
			}
		}
		else
		{
			data = compressed_data;
			return true;
		}
	}

	bool download_mesh_from_asset_id(uint64_t asset_id, std::vector<uint8_t>& mesh_data)
	{
		if (asset_id == 0)
			return false;
		
		std::vector<uint8_t> api_response;
		std::wstring path = L"/v2/asset/?id=" + std::to_wstring(asset_id);
		if (!download_from_url(L"assetdelivery.roblox.com", path, api_response, false))
		{
			path = L"/v1/asset/?id=" + std::to_wstring(asset_id);
			if (!download_from_url(L"assetdelivery.roblox.com", path, api_response, false))
			{
				logger->log<DEBUG>("[mesh] API failed for asset {}", asset_id);
				return false;
			}
		}
		
		if (api_response.size() >= 12)
		{
			std::string header(reinterpret_cast<const char*>(api_response.data()), 12);
			if (header.find("version ") == 0)
			{
				mesh_data = api_response;
				return true;
			}
		}
		
		std::string response_str(reinterpret_cast<const char*>(api_response.data()), api_response.size());
		
		try
		{
			json api_json = json::parse(response_str);
			
			if (api_json.contains("locations") && api_json["locations"].is_array() && !api_json["locations"].empty())
			{
				std::string location_url;
				auto first_location = api_json["locations"][0];
				
				if (first_location.is_string())
				{
					location_url = first_location.get<std::string>();
				}
				else if (first_location.is_object())
				{
					if (first_location.contains("location"))
					{
						location_url = first_location["location"].get<std::string>();
					}
					else if (first_location.contains("url"))
					{
						location_url = first_location["url"].get<std::string>();
					}
					else
					{
						logger->log<DEBUG>("[mesh] invalid location object for asset {}", asset_id);
						return false;
					}
				}
				else
				{
					logger->log<DEBUG>("[mesh] unexpected location format for asset {}", asset_id);
					return false;
				}
				
				size_t protocol_pos = location_url.find("://");
				if (protocol_pos == std::string::npos)
				{
					logger->log<DEBUG>("[mesh] invalid URL format for asset {}", asset_id);
					return false;
				}
				
				std::string protocol = location_url.substr(0, protocol_pos);
				std::string remaining = location_url.substr(protocol_pos + 3);
				
				size_t path_pos = remaining.find('/');
				if (path_pos == std::string::npos)
				{
					logger->log<DEBUG>("[mesh] invalid URL path for asset {}", asset_id);
					return false;
				}
				
				std::string host = remaining.substr(0, path_pos);
				std::string url_path = remaining.substr(path_pos);
				
				std::wstring w_host(host.begin(), host.end());
				std::wstring w_path(url_path.begin(), url_path.end());
				
				if (!download_from_url(w_host, w_path, mesh_data))
				{
					logger->log<DEBUG>("[mesh] download failed for asset {}", asset_id);
					return false;
				}
				
				return true;
			}
			else
			{
				logger->log<DEBUG>("[mesh] no locations in API response for asset {}", asset_id);
				return false;
			}
		}
		catch (const std::exception& e)
		{
			mesh_data = api_response;
			return true;
		}
	}

	uint64_t get_mesh_asset_id_from_part(uint64_t part_address)
	{
		if (part_address == 0)
			return 0;

		std::string class_name = rbx::c_instance(part_address).get_class_name();
		if (class_name != "MeshPart")
			return 0;

		std::string mesh_id_string = get_mesh_id_string(part_address);
		if (mesh_id_string.empty())
			return 0;

		return extract_asset_id(mesh_id_string);
	}

	bool parse_and_cache_part_mesh(const std::string& part_name, uint64_t part_address, uint64_t asset_id, parsed_mesh& out_mesh)
	{
		if (asset_id == 0)
			return false;

		std::string cache_name = "mesh_" + std::to_string(asset_id);
		
		if (load_parsed_mesh(cache_name, out_mesh))
		{
			return true;
		}

		std::vector<uint8_t> mesh_data;
		if (!download_mesh_from_asset_id(asset_id, mesh_data))
		{
			return false;
		}

		if (mesh_data.empty() || mesh_data.size() < 12)
		{
			return false;
		}

		if (!parse_mesh_from_data(mesh_data, out_mesh))
		{
			return false;
		}

		if (out_mesh.vertices.empty() || out_mesh.faces.empty())
		{
			return false;
		}

		save_parsed_mesh(cache_name, out_mesh);
		return true;
	}

	character_mesh_cache* get_or_create_character_cache(uint64_t character_address)
	{
		if (character_address == 0)
			return nullptr;

		std::lock_guard<std::mutex> lock(g_cache_mutex);
		auto it = g_character_caches.find(character_address);
		if (it != g_character_caches.end())
		{
			return &it->second;
		}

		auto& cache = g_character_caches[character_address];
		cache.is_valid = false;
		return &cache;
	}

	static void mesh_processing_thread()
	{
		while (g_thread_running)
		{
			std::unique_lock<std::mutex> queue_lock(g_queue_mutex);
			g_queue_cv.wait(queue_lock, [] { return !g_mesh_queue.empty() || !g_thread_running; });

			if (!g_thread_running)
				break;

			if (g_mesh_queue.empty())
				continue;

			mesh_queue_item item = g_mesh_queue.front();
			g_mesh_queue.pop();
			queue_lock.unlock();

			{
				std::lock_guard<std::mutex> cache_lock(g_cache_mutex);
				auto cache_it = g_character_caches.find(item.character_address);
				if (cache_it == g_character_caches.end())
					continue;

				auto& cache = cache_it->second;
				auto cached_it = cache.part_asset_ids.find(item.part_name);
				if (cached_it != cache.part_asset_ids.end() && cached_it->second == item.asset_id)
					continue;

				if (g_processing_assets.find(item.asset_id) != g_processing_assets.end())
					continue;

				g_processing_assets.insert(item.asset_id);
			}

			parsed_mesh mesh;
			if (parse_and_cache_part_mesh(item.part_name, item.part_address, item.asset_id, mesh))
			{
				std::lock_guard<std::mutex> cache_lock(g_cache_mutex);
				auto cache_it = g_character_caches.find(item.character_address);
				if (cache_it != g_character_caches.end())
				{
					cache_it->second.part_meshes[item.part_name] = std::move(mesh);
					cache_it->second.part_asset_ids[item.part_name] = item.asset_id;
					cache_it->second.is_valid = true;
				}
			}

			{
				std::lock_guard<std::mutex> cache_lock(g_cache_mutex);
				g_processing_assets.erase(item.asset_id);
			}

			std::this_thread::sleep_for(std::chrono::milliseconds(500));
		}
	}

	void update_character_meshes(uint64_t character_address, const std::unordered_map<std::string, uint64_t>& parts)
	{
		if (character_address == 0)
			return;

		if (!g_thread_running)
		{
			g_thread_running = true;
			g_processing_thread = std::thread(mesh_processing_thread);
		}

		character_mesh_cache* cache = get_or_create_character_cache(character_address);
		if (!cache)
			return;

		std::lock_guard<std::mutex> cache_lock(g_cache_mutex);

		for (const auto& pair : parts)
		{
			const std::string& part_name = pair.first;
			uint64_t part_address = pair.second;

			if (part_address == 0 || part_name == "HumanoidRootPart")
				continue;

			uint64_t asset_id = get_mesh_asset_id_from_part(part_address);
			if (asset_id == 0)
				continue;

			auto cached_it = cache->part_asset_ids.find(part_name);
			if (cached_it != cache->part_asset_ids.end() && cached_it->second == asset_id)
			{
				continue;
			}

			{
				std::lock_guard<std::mutex> queue_lock(g_queue_mutex);
				bool already_queued = false;
				std::queue<mesh_queue_item> temp_queue = g_mesh_queue;
				while (!temp_queue.empty())
				{
					if (temp_queue.front().character_address == character_address && 
					    temp_queue.front().part_name == part_name &&
					    temp_queue.front().asset_id == asset_id)
					{
						already_queued = true;
						break;
					}
					temp_queue.pop();
				}

				if (!already_queued && g_processing_assets.find(asset_id) == g_processing_assets.end())
				{
					g_mesh_queue.push({ character_address, part_name, part_address, asset_id });
					g_queue_cv.notify_one();
				}
			}
		}
	}

	void clear_character_cache(uint64_t character_address)
	{
		if (character_address == 0)
			return;

		std::lock_guard<std::mutex> lock(g_cache_mutex);
		g_character_caches.erase(character_address);
	}

	const parsed_mesh* get_cached_mesh(uint64_t character_address, const std::string& part_name)
	{
		if (character_address == 0 || part_name.empty())
			return nullptr;

		std::lock_guard<std::mutex> lock(g_cache_mutex);
		auto it = g_character_caches.find(character_address);
		if (it == g_character_caches.end() || !it->second.is_valid)
			return nullptr;

		auto mesh_it = it->second.part_meshes.find(part_name);
		if (mesh_it == it->second.part_meshes.end())
			return nullptr;

		return &mesh_it->second;
	}
}



