--  4.  ImNotify  -  toast notifications
-- ---------------------------------------------------------------------------
local ImNotify = {}
local notifications = {}

local NOTIFY_COLOR = {
    Info    = RGB(0.25, 0.64, 0.93),
    Success = RGB(0.08, 0.59, 0.12),
    Warn    = RGB(0.93, 0.61, 0.25),
    Error   = RGB(0.84, 0.27, 0.31),
    None    = RGB(0.83, 0.83, 0.83),
}
local NOTIFY_LIFETIME = 5.0

function ImNotify.Print(level, text)
    notifications[#notifications + 1] = {
        text = text,
        level = level or "Info",
        ttl = NOTIFY_LIFETIME,
    }
end

function ImNotify.Update()
    local dt = I.GetIO().DeltaTime or 0.016
    for i = #notifications, 1, -1 do
        notifications[i].ttl = notifications[i].ttl - dt
        if notifications[i].ttl <= 0 then table.remove(notifications, i) end
    end
end

function ImNotify.Render()
    local dl = I.GetForegroundDrawList and I.GetForegroundDrawList()
    if not dl then return end
    local vp_w, vp_h = I.GetIO().DisplaySize
    local pad      = 12
    local h        = I.GetFontSize() + pad * 2
    local y        = vp_h - pad

    for i = #notifications, 1, -1 do
        local n = notifications[i]
        local tw = I.CalcTextSize(n.text)
        local w  = tw + pad * 3
        local x  = vp_w - w - pad
        y = y - h - 6

        local col = NOTIFY_COLOR[n.level] or NOTIFY_COLOR.None
        local alpha = math.min(1, n.ttl / 0.6, (NOTIFY_LIFETIME - n.ttl) / 0.3)
        dl:AddRectFilled(x, y, x + w, y + h,
                         ColorU32(RGB(0.10, 0.11, 0.13, 0.92 * alpha)), 6)

        -- Left progress bar
        local frac = n.ttl / NOTIFY_LIFETIME
        dl:AddRectFilled(x, y, x + w * frac, y + h,
                         ColorU32(RGB(col.r, col.g, col.b, 0.35 * alpha)), 6)

        -- Border
        dl:AddRect(x, y, x + w, y + h,
                   ColorU32(RGB(col.r, col.g, col.b, 0.85 * alpha)), 6, 0, 1)

        -- Text
        dl:AddText(x + pad, y + pad,
                   ColorU32(RGB(col.r, col.g, col.b, alpha)), n.text)
    end
end

