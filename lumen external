static inline void shoot_once()
{
	if (settings::triggerbot::delay > 0.f || settings::triggerbot::randomize_delay)
	{
		std::int32_t delay_ms = static_cast<std::int32_t>(settings::triggerbot::delay);

		if (settings::triggerbot::randomize_delay)
		{
			std::uniform_real_distribution<float> dis(settings::triggerbot::delay_min, settings::triggerbot::delay_max);
			delay_ms = static_cast<std::int32_t>(dis(gen));
		}

		std::this_thread::sleep_for(std::chrono::milliseconds(delay_ms));
	}

	INPUT inputs[2]{};
	inputs[0].type = INPUT_MOUSE;
	inputs[0].mi.dwFlags = MOUSEEVENTF_LEFTDOWN;
	inputs[1].type = INPUT_MOUSE;
	inputs[1].mi.dwFlags = MOUSEEVENTF_LEFTUP;

	SendInput(2, inputs, sizeof(INPUT));
}

static inline bool is_mouse_hovering_part(const float mouse_x, const float mouse_y, rbx::c_part& part, const math::matrix4& view, const math::vector2& dims)
{
	rbx::c_primitive primitive = part.get_primitive();
	if (!primitive.address)
	{
		return false;
	}

	const math::vector3 size = primitive.get_size();
	const math::vector3 pos = primitive.get_position();
	const math::matrix3 rot = primitive.get_rotation();

	const float hx = size.x * 0.5f;
	const float hy = size.y * 0.5f;
	const float hz = size.z * 0.5f;

	math::vector2 screen_corners[8];
	math::vector3 corners[8] = {
		pos + rot * math::vector3{ -hx, hy, hz },
		pos + rot * math::vector3{ hx, hy, hz },
		pos + rot * math::vector3{ -hx, -hy, hz },
		pos + rot * math::vector3{ hx, -hy, hz },
		pos + rot * math::vector3{ -hx, hy, -hz },
		pos + rot * math::vector3{ hx, hy, -hz },
		pos + rot * math::vector3{ -hx, -hy, -hz },
		pos + rot * math::vector3{ hx, -hy, -hz }
	};

	float min_x = 999999.f;
	float max_x = -999999.f;
	float min_y = 999999.f;
	float max_y = -999999.f;

	for (std::int32_t i = 0; i < 8; ++i)
	{
		if (!game::visualengine->world_to_screen(view, dims, corners[i], screen_corners[i]))
		{
			return false;
		}

		if (screen_corners[i].x < min_x) min_x = screen_corners[i].x;
		if (screen_corners[i].x > max_x) max_x = screen_corners[i].x;
		if (screen_corners[i].y < min_y) min_y = screen_corners[i].y;
		if (screen_corners[i].y > max_y) max_y = screen_corners[i].y;
	}

	return (mouse_x >= min_x && mouse_x <= max_x && mouse_y >= min_y && mouse_y <= max_y);
}

void triggerbot::run()
{
	HWND roblox_window = nullptr;
	bool teamcheck_enabled = false;
	bool knock_check_enabled = false;

	for (;;)
	{
		std::this_thread::sleep_for(std::chrono::milliseconds(1));

		keybind::keybind_t triggerbot_kb{};
		triggerbot_kb.key = settings::triggerbot::keybind;
		triggerbot_kb.mode = static_cast<keybind::activation_mode>(settings::triggerbot::activation_mode);

		if (!settings::triggerbot::enabled || !keybind::is_active(triggerbot_kb))
		{
			continue;
		}

		if (!game::visualengine || !game::datamodel)
		{
			continue;
		}

		if (!roblox_window || !IsWindow(roblox_window))
		{
			roblox_window = game::get_roblox_window();
		}

		if (!roblox_window || GetForegroundWindow() != roblox_window)
		{
			continue;
		}

		POINT cursor{};
		GetCursorPos(&cursor);
		const float mouse_x = static_cast<float>(cursor.x);
		const float mouse_y = static_cast<float>(cursor.y);

		const math::matrix4 view = game::visualengine->get_viewmatrix();
		const math::vector2 dims = game::visualengine->get_dimensions();

		teamcheck_enabled = settings::triggerbot::teamcheck;
		knock_check_enabled = settings::triggerbot::knock_check;

		std::vector<cache::entity_t> entities_snapshot;
		{
			std::lock_guard<std::mutex> lock(cache::mtx);
			entities_snapshot = cache::players;
		}

		bool shot = false;
		const std::uint64_t local_addr = cache::local_player.instance.address;
		const std::uint64_t local_team = cache::local_player.team;

		for (cache::entity_t& entity : entities_snapshot)
		{
			if (entity.instance.address == local_addr)
			{
				continue;
			}

			if (teamcheck_enabled && entity.team == local_team)
			{
				continue;
			}

			if (knock_check_enabled && entity.knocked)
			{
				continue;
			}

			if (settings::triggerbot::health_check_enabled && entity.health < settings::triggerbot::min_health)
			{
				continue;
			}

			for (auto& [part_name, part] : entity.parts)
			{
				if (!part.address)
				{
					continue;
				}

				if (is_mouse_hovering_part(mouse_x, mouse_y, part, view, dims))
				{
					shoot_once();
					shot = true;
					break;
				}
			}

			if (shot)
			{
				break;
			}
		}
	}
}


