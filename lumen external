void c_keyauth::session_status() {
	KeyAuthApp.check(true);
	if (!KeyAuthApp.response.success) {
		exit(0);
	}

	if (KeyAuthApp.response.isPaid) {
		while (true) {
			Sleep(20000);
			KeyAuthApp.check();
			if (!KeyAuthApp.response.success) {
				exit(0);
			}
		}
	}
}

bool c_keyauth::authenticate()
{
	bool success{};
	KeyAuthApp.init();

	std::string username, password, code;

	if (!KeyAuthApp.response.success)
	{
		logger->log<INFO>("[auth] status: {}", KeyAuthApp.response.message);
		Sleep(1500);
		exit(1);
	}

	char appdata_path[MAX_PATH];
	std::string config_dir{};
	std::string key_path{};

	if (SUCCEEDED(SHGetFolderPathA(NULL, CSIDL_APPDATA, NULL, SHGFP_TYPE_CURRENT, appdata_path)))
	{
		config_dir = std::string(appdata_path) + "\\Lumen\\Auth\\";
		std::filesystem::create_directories(config_dir);
		key_path = config_dir + "auth.json";
	}

	if (std::filesystem::exists(key_path))
	{
		if (check_json_key(key_path, "username") && check_json_key(key_path, "password"))
		{
			username = read_json(key_path, "username");
			password = read_json(key_path, "password");
			KeyAuthApp.login(username, password);
		}
		else
		{
			logger->log_inline<INFO>("[auth] enter username: ");
			std::cin >> username;
			logger->log_inline<INFO>("[auth] enter password: ");
			std::cin >> password;
			KeyAuthApp.login(username, password);
		}
	}
	else
	{
		logger->log_inline<INFO>("[auth] enter username: ");
		std::cin >> username;
		logger->log_inline<INFO>("[auth] enter password: ");
		std::cin >> password;
		KeyAuthApp.login(username, password);
	}

	if (KeyAuthApp.response.message.empty()) exit(11);

	if (!KeyAuthApp.response.success)
	{
		if (KeyAuthApp.response.message == "2FA code required.")
		{
			logger->log_inline<INFO>("[auth] your account has 2FA enabled, please enter 6-digit code:");
			std::cin >> code;
			KeyAuthApp.login(username, password, code);

			if (KeyAuthApp.response.message.empty()) exit(11);
			if (!KeyAuthApp.response.success)
			{
				logger->log<INFO>("[auth] status: {}", KeyAuthApp.response.message);
				std::remove(key_path.c_str());
				Sleep(1500);
				exit(1);
			}
		}
		else
		{
			logger->log<INFO>("[auth] status: {}", KeyAuthApp.response.message);
			std::remove(key_path.c_str());
			Sleep(1500);
			exit(1);
		}
	}

	write_json(key_path, "username", username, true, "password", password);

	std::thread run(check_auth, ownerid);
	std::thread check([&]() { session_status(); });

	run.detach();
	check.detach();

	return true;
}

